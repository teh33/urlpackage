{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urlpackage.dev/schema/urlpackage.schema.json",
  "title": "URLPackage",
  "description": "A portable package of curated web links and metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["urlpackage", "title", "links"],
  "properties": {
    "urlpackage": { "type": "string", "const": "0.1" },
    "id": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "image": { "type": "string" },
    "icon": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "license": { "type": "string" },
    "source": { "type": "string", "format": "uri" },
    "tags": { "$ref": "#/$defs/tags" },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "email": { "type": "string", "format": "email" }
        }
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/link" }
    }
  },
  "$defs": {
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "icon": { "type": "string" },
        "tags": { "$ref": "#/$defs/tags" },
        "addedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastKnownGood": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["unknown", "ok", "redirected", "broken", "archived"] },
        "notes": { "type": "string" }
      }
    }
  }
}
